{
  "name": "@jingles/electron",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node scripts/start-electron.cjs",
    "dev": "node scripts/start-electron.cjs",
    "test": "jest --forceExit",
    "native:rebuild": "electron-rebuild -f -w better-sqlite3 -m .",
    "electron:pack": "electron-builder --win nsis"
  },
  "dependencies": {
    "@jingles/shared": "*",
    "better-sqlite3": "^12.10.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.jingles.pos",
    "electronVersion": "41.4.0",
    "npmRebuild": false,
    "productName": "Jingles POS",
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "../../release/electron"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
