{
  "name": "@jingles/electron",
  "version": "1.0.1",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node scripts/start-electron.cjs",
    "dev": "node scripts/start-electron.cjs",
    "test": "jest --forceExit",
    "native:rebuild": "electron-rebuild -f -w better-sqlite3 -m .",
    "electron:pack": "electron-builder --win nsis",
    "build:update": "node scripts/build-update.cjs JINGLES_POS_UPDATE_URL"
  },
  "dependencies": {
    "@jingles/shared": "*",
    "@prisma/client": "^5.7.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "typesense": "^3.0.3",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "ws": "^8.20.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.jingles.pos",
    "electronVersion": "41.4.0",
    "npmRebuild": false,
    "productName": "Jingles POS",
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      "node_modules/.prisma/**/*",
      {
        "from": "../../node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../backend/dist",
        "to": "backend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/prisma",
        "to": "backend/prisma",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "../../release/electron"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    }
  }
}
